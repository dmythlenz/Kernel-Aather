# ═══════════════════════════════════════════════════════════════════════════
# KAE-SYSTEM Aether WASM Compiler — written entirely in the Aether language
# Self-hosting: compiles an Aether subset (fn name(args) -> expr) into a
# WebAssembly binary module, stored to HyperFS as base64, executable by any
# WebAssembly runtime (browsers, Node, Wasmtime, Wasmer).
# ═══════════════════════════════════════════════════════════════════════════

# ── §1 LEB128 encoders ──────────────────────────────────────────────────────
fn uleb(n)
  mut bytes = []
  mut v = n
  mut done = false
  while done == false
    let b = v % 128
    v = int(v / 128)
    if v > 0
      push(bytes, b + 128)
    else
      push(bytes, b)
      done = true
  return bytes

fn sleb(n)
  mut bytes = []
  mut v = n
  mut done = false
  while done == false
    mut b = v % 128
    v = int(v / 128)
    if b < 0
      b += 128
      v -= 1
    if (v == 0 && b < 64) || (v == -1 && b >= 64)
      push(bytes, b)
      done = true
    else
      push(bytes, b + 128)
  return bytes

# ── §2 ASCII map (printable 32..126) ────────────────────────────────────────
fn asciiOf(c)
  let T = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  let i = indexOf(T, c)
  if i >= 0
    return 32 + i
  return 0

fn nameBytes(s)
  mut out = uleb(len(s))
  let i = 0
  while i < len(s)
    push(out, asciiOf(substr(s, i, 1)))
    i += 1
  return out

# ── §3 Lexer ────────────────────────────────────────────────────────────────
# tokens: ["num", v] ["id", name] ["op", op] ["lp"] ["rp"] ["comma"] ["q"] ["colon"]
fn tokenize(expr)
  mut toks = []
  let i = 0
  let n = len(expr)
  while i < n
    let c = substr(expr, i, 1)
    let two = substr(expr, i, 2)
    if c == " " || c == "\n"
      i += 1
    else if indexOf("0123456789", c) >= 0
      let start = i
      while i < n && indexOf("0123456789", substr(expr, i, 1)) >= 0
        i += 1
      push(toks, ["num", int(substr(expr, start, i - start))])
    else if indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0
      let start = i
      while i < n && indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", substr(expr, i, 1)) >= 0
        i += 1
      push(toks, ["id", substr(expr, start, i - start)])
    else if two == "<=" || two == ">=" || two == "==" || two == "!="
      push(toks, ["op", two])
      i += 2
    else if c == "<" || c == ">" || c == "!"
      push(toks, ["op", c])
      i += 1
    else if indexOf("+-*/%", c) >= 0
      push(toks, ["op", c])
      i += 1
    else if c == "("
      push(toks, ["lp", "("])
      i += 1
    else if c == ")"
      push(toks, ["rp", ")"])
      i += 1
    else if c == ","
      push(toks, ["comma", ","])
      i += 1
    else if c == "?"
      push(toks, ["q", "?"])
      i += 1
    else if c == ":"
      push(toks, ["colon", ":"])
      i += 1
    else
      i += 1
  return toks

# ── §4 Parser (recursive descent, returns [ast, pos]) ───────────────────────
# ast: ["num", v] ["id", name] ["neg", x] ["bin", op, l, r]
#      ["tern", c, t, e] ["call", name, [args...]]
fn parsePrimary(toks, pos)
  let t = get(toks, pos)
  let type = get(t, 0)
  if type == "num"
    return [["num", get(t, 1)], pos + 1]
  if type == "id"
    let name = get(t, 1)
    if pos + 1 < len(toks) && get(get(toks, pos + 1), 0) == "lp"
      mut args = []
      mut p = pos + 2
      while get(get(toks, p), 0) != "rp"
        let a = parseExpr(toks, p)
        push(args, get(a, 0))
        p = get(a, 1)
        if p < len(toks) && get(get(toks, p), 0) == "comma"
          p += 1
      return [["call", name, args], p + 1]
    return [["id", name], pos + 1]
  if type == "lp"
    let inner = parseExpr(toks, pos + 1)
    return [get(inner, 0), get(inner, 1) + 1]
  if type == "op" && get(t, 1) == "-"
    let u = parsePrimary(toks, pos + 1)
    return [["neg", get(u, 0)], get(u, 1)]
  return [["num", 0], pos + 1]

fn parseMul(toks, pos)
  let l = parsePrimary(toks, pos)
  mut ast = get(l, 0)
  mut p = get(l, 1)
  while p < len(toks) && get(get(toks, p), 0) == "op" && (get(get(toks, p), 1) == "*" || get(get(toks, p), 1) == "/" || get(get(toks, p), 1) == "%")
    let op = get(get(toks, p), 1)
    let r = parsePrimary(toks, p + 1)
    ast = ["bin", op, ast, get(r, 0)]
    p = get(r, 1)
  return [ast, p]

fn parseAdd(toks, pos)
  let l = parseMul(toks, pos)
  mut ast = get(l, 0)
  mut p = get(l, 1)
  while p < len(toks) && get(get(toks, p), 0) == "op" && (get(get(toks, p), 1) == "+" || get(get(toks, p), 1) == "-")
    let op = get(get(toks, p), 1)
    let r = parseMul(toks, p + 1)
    ast = ["bin", op, ast, get(r, 0)]
    p = get(r, 1)
  return [ast, p]

fn parseCmp(toks, pos)
  let l = parseAdd(toks, pos)
  mut ast = get(l, 0)
  mut p = get(l, 1)
  while p < len(toks) && get(get(toks, p), 0) == "op" && indexOf("<=>!=", get(get(toks, p), 1)) >= 0
    let op = get(get(toks, p), 1)
    let r = parseAdd(toks, p + 1)
    ast = ["bin", op, ast, get(r, 0)]
    p = get(r, 1)
  return [ast, p]

fn parseExpr(toks, pos)
  let left = parseCmp(toks, pos)
  let p = get(left, 1)
  if p < len(toks) && get(get(toks, p), 0) == "q"
    let thenR = parseExpr(toks, p + 1)
    let p2 = get(thenR, 1)
    let elseR = parseExpr(toks, p2 + 1)
    return [["tern", get(left, 0), get(thenR, 0), get(elseR, 0)], get(elseR, 1)]
  return left

# ── §5 Source parser: "fn name(p1, p2) -> expr" lines ──────────────────────
fn parseSource(src)
  mut funcs = []
  let lines = split(src, "\n")
  for line in lines
    if startsWith(line, "fn ")
      let lp = indexOf(line, "(")
      let rp = indexOf(line, ")")
      let arrow = indexOf(line, "->")
      let name = trim(substr(line, 3, lp - 3))
      let paramsPart = trim(substr(line, lp + 1, rp - lp - 1))
      let exprPart = trim(substr(line, arrow + 2, len(line) - arrow - 2))
      mut params = []
      if len(paramsPart) > 0
        let ps = split(paramsPart, ",")
        for p in ps
          push(params, trim(p))
      let toks = tokenize(exprPart)
      let parsed = parseExpr(toks, 0)
      push(funcs, [name, params, get(parsed, 0)])
  return funcs

# ── §6 Emitter (AST → WASM body bytes) ─────────────────────────────────────
fn concat(a, b)
  mut out = []
  let i = 0
  while i < len(a)
    push(out, get(a, i))
    i += 1
  let j = 0
  while j < len(b)
    push(out, get(b, j))
    j += 1
  return out

fn emit(ast, locals, fnMap)
  let t = get(ast, 0)
  if t == "num"
    return concat([65], sleb(get(ast, 1)))
  if t == "id"
    return concat([32], uleb(get(locals, get(ast, 1))))
  if t == "neg"
    return concat([65, 0], concat(emit(get(ast, 1), locals, fnMap), [107]))
  if t == "bin"
    let op = get(ast, 1)
    mut opcode = 106
    if op == "-"
      opcode = 107
    else if op == "*"
      opcode = 108
    else if op == "/"
      opcode = 109
    else if op == "%"
      opcode = 111
    else if op == "<"
      opcode = 72
    else if op == "<="
      opcode = 76
    else if op == ">"
      opcode = 74
    else if op == ">="
      opcode = 78
    else if op == "=="
      opcode = 70
    else if op == "!="
      opcode = 71
    return concat(emit(get(ast, 2), locals, fnMap), concat(emit(get(ast, 3), locals, fnMap), [opcode]))
  if t == "tern"
    return concat(emit(get(ast, 1), locals, fnMap), concat([4, 127], concat(emit(get(ast, 2), locals, fnMap), concat([5], concat(emit(get(ast, 3), locals, fnMap), [11])))))
  if t == "call"
    mut out = []
    let i = 0
    while i < len(get(ast, 2))
      out = concat(out, emit(get(get(ast, 2), i), locals, fnMap))
      i += 1
    return concat(out, concat([16], uleb(get(fnMap, get(ast, 1)))))
  return [0, 11]

# ── §7 Module builder ───────────────────────────────────────────────────────
fn buildModule(funcs)
  let n = len(funcs)
  mut fnMap = {}
  let m = 0
  while m < n
    put(fnMap, get(get(funcs, m), 0), m)
    m += 1
  mut wasm = []
  push(wasm, 0)
  push(wasm, 97)
  push(wasm, 115)
  push(wasm, 109)
  push(wasm, 1)
  push(wasm, 0)
  push(wasm, 0)
  push(wasm, 0)
  # type section (id 1)
  mut typeContent = uleb(n)
  let i = 0
  while i < n
    let f = get(funcs, i)
    typeContent = concat(typeContent, [96])
    typeContent = concat(typeContent, uleb(len(get(f, 1))))
    let k = 0
    while k < len(get(f, 1))
      typeContent = concat(typeContent, [127])
      k += 1
    typeContent = concat(typeContent, [1, 127])
    i += 1
  wasm = concat(wasm, [1])
  wasm = concat(wasm, uleb(len(typeContent)))
  wasm = concat(wasm, typeContent)
  # function section (id 3): type indices 0..n-1
  mut fnContent = uleb(n)
  let j = 0
  while j < n
    fnContent = concat(fnContent, uleb(j))
    j += 1
  wasm = concat(wasm, [3])
  wasm = concat(wasm, uleb(len(fnContent)))
  wasm = concat(wasm, fnContent)
  # export section (id 7)
  mut expContent = uleb(n)
  let e = 0
  while e < n
    expContent = concat(expContent, nameBytes(get(get(funcs, e), 0)))
    expContent = concat(expContent, [0])
    expContent = concat(expContent, uleb(e))
    e += 1
  wasm = concat(wasm, [7])
  wasm = concat(wasm, uleb(len(expContent)))
  wasm = concat(wasm, expContent)
  # code section (id 10)
  mut codeContent = uleb(n)
  let c = 0
  while c < n
    let f = get(funcs, c)
    mut locals = {}
    let li = 0
    while li < len(get(f, 1))
      put(locals, get(get(f, 1), li), li)
      li += 1
    let body = emit(get(f, 2), locals, fnMap)
    body = concat(body, [11])
    let entry = concat([0], body)
    codeContent = concat(codeContent, uleb(len(entry)))
    codeContent = concat(codeContent, entry)
    c += 1
  wasm = concat(wasm, [10])
  wasm = concat(wasm, uleb(len(codeContent)))
  wasm = concat(wasm, codeContent)
  return wasm

# ── §8 Base64 encoder (byte list → ASCII string) ───────────────────────────
fn b64encode(bytes)
  let T = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  mut out = ""
  let i = 0
  let n = len(bytes)
  while i + 2 < n
    let b1 = get(bytes, i)
    let b2 = get(bytes, i + 1)
    let b3 = get(bytes, i + 2)
    out += substr(T, int(b1 / 4), 1)
    out += substr(T, (b1 % 4) * 16 + int(b2 / 16), 1)
    out += substr(T, (b2 % 16) * 4 + int(b3 / 64), 1)
    out += substr(T, b3 % 64, 1)
    i += 3
  if i + 1 == n
    let b1 = get(bytes, i)
    out += substr(T, int(b1 / 4), 1)
    out += substr(T, (b1 % 4) * 16, 1)
    out += "=="
  else if i + 2 == n
    let b1 = get(bytes, i)
    let b2 = get(bytes, i + 1)
    out += substr(T, int(b1 / 4), 1)
    out += substr(T, (b1 % 4) * 16 + int(b2 / 16), 1)
    out += substr(T, (b2 % 16) * 4, 1)
    out += "="
  return out

# ── §9 MAIN: compile the Aether kernel to WASM ──────────────────────────────
let src = "fn fact(n) -> n <= 1 ? 1 : n * fact(n - 1)\nfn fib(n) -> n < 2 ? n : fib(n - 1) + fib(n - 2)\nfn add(a, b) -> a + b\nfn mul(a, b) -> a * b"
let funcs = parseSource(src)
print "parsed functions: " + str(len(funcs))
let wasm = buildModule(funcs)
print "wasm module: " + str(len(wasm)) + " bytes"
let b64 = b64encode(wasm)
kae.write("wasm:kernel", b64)
print "stored HyperFS: wasm:kernel (" + str(len(b64)) + " base64 chars)"
print "magic: " + str(get(wasm, 0)) + " " + str(get(wasm, 1)) + " " + str(get(wasm, 2)) + " " + str(get(wasm, 3))
print "COMPILE OK — KAE-SYSTEM kernel compiled to WASM by Aether itself"